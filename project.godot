[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.063, 1)

[xr]

; OpenXR is provided by Godot 4; vendor extensions are supplied by the addon.

[xr/openxr/extensions]
hand_tracking=true

[physics]
common/enable_pause_aware_picking=true

[sentry]
options/dsn="https://1e4068793802934c1148bda528f524dc@o4512151214555136.ingest.us.sentry.io/4512151275831296"
options/enable_logs=true
options/godot_logger/enabled=true
options/godot_logger/include_source_context=true
options/godot_logger/include_variables=true
options/godot_logger/event_mask=15
options/godot_logger/breadcrumb_mask=143
options/godot_logger/log_mask=143
